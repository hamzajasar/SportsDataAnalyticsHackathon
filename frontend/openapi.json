      "get": {
        "tags": [
          "share"
        ],
        "summary": "Nearest",
        "operationId": "nearestVenues",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 46,
              "minimum": 42,
              "title": "Lat"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 20,
              "minimum": 15,
              "title": "Lon"
            }
          },
          {
            "name": "n",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 10,
              "title": "N"
            }
          },
          {
            "name": "leisure",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(pitch|stadium|sports_centre|sports_hall)$"
