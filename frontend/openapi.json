  "components": {
    "schemas": {
      "AmountEstimate": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "kg_co2e": {
            "type": "number",
            "title": "Kg Co2E"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "total_kg_co2e": {
            "type": "number",
            "title": "Total Kg Co2E"
          },
          "source": {
            "type": "string",
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "key",
          "unit",
          "kg_co2e",
          "amount",
          "total_kg_co2e",
          "source"
        ],
        "title": "AmountEstimate"
      },
      "ClubAssumptions": {
        "properties": {
          "costs": {
            "items": {
              "$ref": "#/components/schemas/CostAssumption"
            },
            "type": "array",
            "title": "Costs"
          },
          "upgrades": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Upgrades"
          },
          "pv_yield_monthly": {
            "items": {
              "$ref": "#/components/schemas/MonthlyValue"
            },
            "type": "array",
            "title": "Pv Yield Monthly"
          },
          "temperature_monthly": {
            "items": {
              "$ref": "#/components/schemas/MonthlyValue"
            },
            "type": "array",
            "title": "Temperature Monthly"
          }
        },
        "type": "object",
        "required": [
          "costs",
          "upgrades",
          "pv_yield_monthly",
          "temperature_monthly"
        ],
        "title": "ClubAssumptions"
      },
      "ColumnSummary": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "null_pct": {
            "type": "number",
            "title": "Null Pct"
          },
          "approx_unique": {
            "type": "integer",
