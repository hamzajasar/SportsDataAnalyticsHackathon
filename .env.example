# Copy to .env (never commit .env). Real secrets go ONLY in .env or the hosting dashboard.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://hackathon:hackathon@localhost:5432/hackathon
CORS_ORIGINS=["http://localhost:5173"]
# Add API keys for data sources here, e.g.
# SPORTS_API_KEY=

# "Snap your bill": reads bill photos with Claude. Optional: without it that endpoint answers 503.
# Alternatively run `ant auth login`. Never commit a real key.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# BILL_READS_PER_HOUR=20
