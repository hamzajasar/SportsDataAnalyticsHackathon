# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Env / secrets
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Data (keep folder structure only)
data/raw/*
data/processed/*
!data/**/.gitkeep
# Dataset formats are ignored EVERYWHERE (organisers' data must not reach git).
# To commit a small hand-made file on purpose: git add -f path/to/file
# Exception: small derived reference tables the app computes with (sources credited in-file)
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.jsonl
*.ndjson
*.zip
*.gz
!backend/app/reference/*.csv
# Cleaned, small, shareable data the team works from (raw downloads stay in data/raw, ignored)
!data/clean/
!data/clean/**
*.db
*.duckdb
*.sqlite

# Models / artifacts
models/*
!models/.gitkeep
*.ckpt

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/

# Node
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
*.local
*.log
npm-debug.log*

# Claude Code (local only)
CLAUDE.md
.claude/

# Raw downloads (large)
data/raw/*
!data/raw/.gitkeep

# macOS/iCloud sync conflict copies, e.g. "actions 2.py" (never commit these)
* [0-9].*
* [0-9]
